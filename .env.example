# Copy to .env and supply local values. Never commit .env.
NODE_ENV=development
JWT_SECRET=
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_billing_optimizer
DB_USER=
DB_PASSWORD=
BACKEND_PORT=4000
CLIENT_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false

FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
CLEARINGHOUSE_BASE_URL=
CLEARINGHOUSE_CLIENT_ID=
CLEARINGHOUSE_CLIENT_SECRET=
PAYER_API_BASE_URL=
PAYER_API_CLIENT_ID=
PAYER_API_CLIENT_SECRET=
CODING_COVERAGE_SOURCE_URL=
PAYMENT_PROCESSOR_BASE_URL=
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_KMS_KEY_ID=
